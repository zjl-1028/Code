import sys
import json
import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader, random_split
from model_ours_final import OurFinalModel
import functools
print = functools.partial(print, flush=True)

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

MAX_LEN = 30
BATCH_SIZE = 128
EPOCHS = 30
LR = 1e-3
WEIGHT_DECAY = 1e-4
MIN_FREQ = 5

def build_vocab(file_path):
    word_count = {}
    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            d = json.loads(line)
            words = str(d["reviewText"]).lower().split()
            for w in words:
                word_count[w] = word_count.get(w, 0) + 1

    vocab = {"<PAD>": 0, "<UNK>": 1}
    for w, c in word_count.items():
        if c >= MIN_FREQ:
            vocab[w] = len(vocab)
    return vocab

class ReviewDataset(Dataset):
    def __init__(self, file_path, vocab):
        self.vocab = vocab
        self.data = []
        with open(file_path, 'r', encoding='utf-8') as f:
            for line in f:
                d = json.loads(line)
                ur = str(d["reviewText"])
                ir = str(d["reviewText"])
                tr = str(d["reviewText"])
                score = float(d["overall"])
                self.data.append((ur, ir, tr, score))

    def encode(self, text):
        words = text.lower().split()[:MAX_LEN]
        ids = [self.vocab.get(w, 1) for w in words]
        ids += [0] * (MAX_LEN - len(ids))
        return torch.tensor(ids, dtype=torch.long)

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        ur, ir, tr, score = self.data[idx]
        return self.encode(ur), self.encode(ir), self.encode(tr), torch.tensor(score)

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python train_ours_final.py Electronics_5.json")
        exit()

    data_path = sys.argv[1]
    vocab = build_vocab(data_path)
    dataset = ReviewDataset(data_path, vocab)

    train_len = int(0.8 * len(dataset))
    val_len = len(dataset) - train_len
    train_set, val_set = random_split(dataset, [train_len, val_len])

    train_loader = DataLoader(train_set, batch_size=BATCH_SIZE, shuffle=True, num_workers=4)
    val_loader = DataLoader(val_set, batch_size=BATCH_SIZE, shuffle=False, num_workers=4)

    model = OurFinalModel(len(vocab)).to(DEVICE)
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)

    best_rmse = 999.0

    for epoch in range(1, EPOCHS+1):
        model.train()
        train_loss = 0.0
        for ur, ir, tr, score in train_loader:
            ur, ir, tr, score = ur.to(DEVICE), ir.to(DEVICE), tr.to(DEVICE), score.to(DEVICE)
            optimizer.zero_grad()
            pred = model(ur, ir, tr)
            loss = criterion(pred, score)
            loss.backward()
            optimizer.step()
            train_loss += loss.item()
        train_loss /= len(train_loader)

        model.eval()
        val_loss = 0.0
        with torch.no_grad():
            for ur, ir, tr, score in val_loader:
                ur, ir, tr, score = ur.to(DEVICE), ir.to(DEVICE), tr.to(DEVICE), score.to(DEVICE)
                pred = model(ur, ir, tr)
                val_loss += criterion(pred, score).item()
        val_loss /= len(val_loader)
        rmse = np.sqrt(val_loss)

        print(f"Epoch {epoch:02d} | TrainLoss {train_loss:.4f} | ValRMSE {rmse:.4f}")

        if rmse < best_rmse:
            best_rmse = rmse
            torch.save(model.state_dict(), "our_model_best.pt")
            print(f"→ New best: {best_rmse:.4f}")

    print(f"Training done! Best RMSE: {best_rmse:.4f}")
