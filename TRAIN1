import json
import re
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
from collections import defaultdict
from model import TotalModel

def clean_text(text):
    text = str(text).lower()
    text = re.sub(r'<.*?>', '', text)
    text = re.sub(r'http\S+', '', text)
    text = re.sub(r'[^a-zA-Z0-9\s]', ' ', text)
    text = re.sub(r'\s+', ' ', text).strip()
    return text

def build_vocab(path, sample_num=20000, max_words=20000):
    word_count = {}
    cnt = 0
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            if cnt >= sample_num:
                break
            d = json.loads(line.strip())
            txt = clean_text(d["reviewText"])
            for w in txt.split():
                word_count[w] = word_count.get(w, 0) + 1
            cnt += 1
    vocab = sorted(word_count.items(), key=lambda x: -x[1])[:max_words-2]
    word2idx = {"<PAD>":0, "<UNK>":1}
    for w,_ in vocab:
        word2idx[w] = len(word2idx)
    return word2idx

class SarcDataset(Dataset):
    def __init__(self, path="./Electronics_5.json", sample_num=20000, max_len=48):
        self.word2idx = build_vocab(path, sample_num)
        self.max_len = max_len
        self.user2id = defaultdict(lambda: len(self.user2id))
        self.item2id = defaultdict(lambda: len(self.item2id))
        self.data = []
        cnt = 0
        with open(path, 'r', encoding='utf-8') as f:
            for line in f:
                if cnt >= sample_num:
                    break
                d = json.loads(line.strip())
                uid = self.user2id[d["reviewerID"]]
                iid = self.item2id[d["asin"]]
                txt = clean_text(d["reviewText"])
                score = float(d["overall"])
                self.data.append((uid, iid, txt, score))
                cnt += 1

    def encode(self, text):
        tokens = text.split()[:self.max_len]
        ids = [self.word2idx.get(w,1) for w in tokens]
        pad = [0]*(self.max_len-len(ids))
        return torch.LongTensor(ids+pad)

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        u,i,t,s = self.data[idx]
        inp = self.encode(t)
        return torch.tensor(u), torch.tensor(i), inp, torch.tensor(s, dtype=torch.float32)

def make_cls_label(score):
    lab = torch.zeros_like(score, dtype=torch.long)
    lab[score>=4.0] = 0
    lab[(score>=2.0)&(score<4.0)] = 1
    lab[score<2.0] = 2
    return lab

if __name__ == "__main__":
    device = torch.device("cpu")
    dataset = SarcDataset()
    dataloader = DataLoader(dataset, batch_size=32, shuffle=True, num_workers=0)
    vocab_size = len(dataset.word2idx)
    
    model = TotalModel(len(dataset.user2id), len(dataset.item2id), vocab_size).to(device)
    optimizer = optim.Adam(model.parameters(), lr=1e-3)
    loss_mse = nn.MSELoss()
    loss_ce = nn.CrossEntropyLoss()

    for epoch in range(10):
        loss1_total = 0.0
        loss2_total = 0.0
        model.train()
        
        for u,i,txt,sc in dataloader:
            u,i,txt,sc = u.to(device),i.to(device),txt.to(device),sc.to(device)
            pred_score, pred_cls = model(u,i,txt)
            true_cls = make_cls_label(sc)
            
            l1 = loss_mse(pred_score, sc)
            l2 = loss_ce(pred_cls, true_cls)
            total_loss = l1 + l2
            
            optimizer.zero_grad()
            total_loss.backward()
            optimizer.step()
            
            loss1_total += l1.item()
            loss2_total += l2.item()
        
        print(f"Epoch {epoch+1} | ScoreLoss:{loss1_total/len(dataloader):.4f} | ClsLoss:{loss2_total/len(dataloader):.4f}")
    
    torch.save(model.state_dict(), "weight.pth")
