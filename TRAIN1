import json
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
from collections import defaultdict
from model import TotalModel

def clean_text(text):
    return str(text).lower()

def build_vocab(path, sample_num=20000):
    word_count = defaultdict(int)
    with open(path, 'r', encoding='utf-8') as f:
        for i, line in enumerate(f):
            if i >= sample_num:
                break
            d = json.loads(line)
            words = clean_text(d["reviewText"]).split()
            for w in words:
                word_count[w] += 1
    vocab = {"<PAD>": 0, "<UNK>": 1}
    for w in word_count:
        vocab[w] = len(vocab)
    return vocab

class SarcasmDataset(Dataset):
    def __init__(self, path, vocab, max_len=48, sample_num=20000):
        self.vocab = vocab
        self.max_len = max_len
        self.data = []
        self.user2id = {}
        self.item2id = {}

        with open(path, 'r', encoding='utf-8') as f:
            for i, line in enumerate(f):
                if i >= sample_num:
                    break
                d = json.loads(line)
                uid = d["reviewerID"]
                iid = d["asin"]
                text = d["reviewText"]
                score = float(d["overall"])
                if uid not in self.user2id:
                    self.user2id[uid] = len(self.user2id)
                if iid not in self.item2id:
                    self.item2id[iid] = len(self.item2id)
                self.data.append((uid, iid, text, score))

    def encode(self, text):
        words = clean_text(text).split()
        ids = [self.vocab.get(w, 1) for w in words[:self.max_len]]
        ids += [0] * (self.max_len - len(ids))
        return torch.tensor(ids, dtype=torch.long)

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        uid, iid, text, score = self.data[idx]
        return self.user2id[uid], self.item2id[iid], self.encode(text), torch.tensor(score, dtype=torch.float32)

def get_consistency_label(score, feat, classifier):
    with torch.no_grad():
        logits = classifier(feat)
        sentiment = torch.argmax(logits, dim=-1)

    label = torch.zeros_like(score, dtype=torch.long)
    normal = (score >= 4) & (sentiment == 1) | (score <= 2) & (sentiment == 0)
    sarcasm = (score <= 2) & (sentiment == 1)
    strict = (score >= 4) & (sentiment == 0)

    label[normal] = 0
    label[sarcasm] = 1
    label[strict] = 2
    return label

if __name__ == "__main__":
    path = "Electronics_5.json"
    vocab = build_vocab(path)
    dataset = SarcasmDataset(path, vocab)
    dataloader = DataLoader(dataset, batch_size=32, shuffle=True)

    model = TotalModel(len(dataset.user2id), len(dataset.item2id), len(vocab))
    optimizer = optim.Adam(model.parameters(), lr=1e-3)
    mse = nn.MSELoss()
    ce = nn.CrossEntropyLoss()

    for epoch in range(10):
        model.train()
        total_loss = 0
        for uid, iid, txt, score in dataloader:
            optimizer.zero_grad()
            pred_score, cls_out = model(uid, iid, txt)
            label = get_consistency_label(score, feat, model.classifier)

            loss = mse(pred_score, score) + ce(cls_out, label)
            loss.backward()
            optimizer.step()
            total_loss += loss.item()

        print(f"Epoch {epoch+1} | Loss: {total_loss/len(dataloader):.4f}")

    torch.save(model.state_dict(), "model.pth")
