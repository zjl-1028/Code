import torch
import torch.nn as nn

class WordEmbScore(nn.Module):
    def __init__(self, user_num, item_num, emb=64):
        super().__init__()
        self.u_emb = nn.Embedding(user_num, emb)
        self.i_emb = nn.Embedding(item_num, emb)
        self.fc = nn.Sequential(
            nn.Linear(emb*2, 64),
            nn.ReLU(),
            nn.Linear(64, 1)
        )

    def forward(self, u, i):
        ue = self.u_emb(u)
        ie = self.i_emb(i)
        return self.fc(torch.cat([ue, ie], -1)).squeeze(-1)

class TextFeat(nn.Module):
    def __init__(self, vocab_size, emb_dim=128):
        super().__init__()
        self.emb = nn.Embedding(vocab_size, emb_dim)
        self.conv = nn.Conv1d(emb_dim, 64, 3, padding=1)
        self.pool = nn.AdaptiveAvgPool1d(1)

    def forward(self, x):
        x = self.emb(x).transpose(1, 2)
        x = torch.relu(self.conv(x))
        x = self.pool(x).squeeze(-1)
        return x

class TriCommentCls(nn.Module):
    def __init__(self, in_dim):
        super().__init__()
        self.cls = nn.Linear(in_dim, 3)

    def forward(self, x):
        return self.cls(x)

class SarcCHead(nn.Module):
    def __init__(self, in_dim):
        super().__init__()
        self.net = nn.Sequential(nn.Linear(in_dim, 1), nn.Sigmoid())

    def forward(self, x):
        return self.net(x).squeeze(-1)

class OffsetSHead(nn.Module):
    def __init__(self, in_dim):
        super().__init__()
        self.fc = nn.Linear(in_dim, 1)

    def forward(self, x):
        return self.fc(x).squeeze(-1)

class TotalModel(nn.Module):
    def __init__(self, user_num, item_num, vocab_size):
        super().__init__()
        self.r_branch = WordEmbScore(user_num, item_num)
        self.txt_feat = TextFeat(vocab_size)
        self.cls_head = TriCommentCls(64)
        self.c_head = SarcCHead(64)
        self.s_head = OffsetSHead(64)

    def forward(self, u, i, txt_inp):
        r = self.r_branch(u, i)
        feat = self.txt_feat(txt_inp)
        cls_logits = self.cls_head(feat)
        c = self.c_head(feat)
        s = self.s_head(feat)
        pred_y = r + c * s
        return pred_y, cls_logits
