import torch
import torch.nn as nn
import torch.nn.functional as F

class WordAttnEncoder(nn.Module):
    def __init__(self, vocab_size, embed_dim=100, hidden_dim=64):
        super().__init__()
        self.embedding = nn.Embedding(vocab_size, embed_dim)
        self.conv = nn.Conv1d(embed_dim, hidden_dim, kernel_size=3, padding=1)
        self.attn = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim),
            nn.Tanh(),
            nn.Linear(hidden_dim, 1)
        )

    def forward(self, x):
        x = self.embedding(x).transpose(1, 2)
        x = self.conv(x).transpose(1, 2)
        attn_weight = F.softmax(self.attn(x), dim=1)
        feat = (x * attn_weight).sum(dim=1)
        return feat

class RAA(nn.Module):
    def __init__(self, hidden_dim=64, H=3, lam=0.5):
        super().__init__()
        self.H = H
        self.lam = lam

    def forward(self, u, i):
        hu, hi = u, i
        for _ in range(self.H):
            dist = torch.abs(hu - hi)
            delta_u = F.softmax(-dist, dim=-1)
            tu = hu + self.lam * delta_u
            hu = tu

            delta_i = F.softmax(-dist, dim=-1)
            ti = hi + self.lam * delta_i
            hi = ti
        return hu, hi

class SarcasmCorrection(nn.Module):
    def __init__(self, vocab_size, embed_dim=100, hidden_dim=64):
        super().__init__()
        self.embedding = nn.Embedding(vocab_size, embed_dim)
        self.conv = nn.Conv1d(embed_dim, hidden_dim, kernel_size=3, padding=1)
        self.offset_head = nn.Sequential(
            nn.Linear(hidden_dim, 1),
            nn.Tanh()
        )

    def forward(self, text_ids):
        x = self.embedding(text_ids).transpose(1, 2)
        x = self.conv(x).transpose(1, 2)
        feat = x.mean(dim=1)
        offset = self.offset_head(feat).squeeze(-1)
        return offset

class OurFinalModel(nn.Module):
    def __init__(self, vocab_size):
        super().__init__()
        self.user_enc = WordAttnEncoder(vocab_size)
        self.item_enc = WordAttnEncoder(vocab_size)
        self.raa = RAA()
        self.sarcasm_correction = SarcasmCorrection(vocab_size)
        self.fc = nn.Sequential(
            nn.Linear(128, 128),
            nn.ReLU(),
            nn.Linear(128, 1)
        )

    def forward(self, user_ids, item_ids, text_ids):
        u = self.user_enc(user_ids)
        i = self.item_enc(item_ids)
        u, i = self.raa(u, i)
        base_pred = self.fc(torch.cat([u, i], dim=-1)).squeeze(-1)
        offset = self.sarcasm_correction(text_ids)
        pred = base_pred + offset
        return pred
